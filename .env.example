# Copie para .env (raiz do monorepo) — usado pelo docker compose e dev local.
# NUNCA commitar o .env real.
#
# O compose injeta estas variáveis no backend/frontend (env_file) e usa os
# valores como defaults de interpolação; o environment do compose sobrescreve
# DATABASE_URL/GATEWAY_URL para apontar para a rede interna.

# Postgres — o compose sobrescreve com db:5432; este valor serve para rodar
# o backend localmente fora do compose, contra o Postgres publicado pelo
# próprio compose na porta 5433 (ver docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://eval:eval@localhost:5433/evaluation

# URL do myown-llm-gateway (OpenAI-compatible)
GATEWAY_URL=http://localhost:8000

# Chave virtual do gateway (nunca commitar a real)
GATEWAY_API_KEY=sk-local

# Modelo usado como judge
JUDGE_MODEL=deepseek/deepseek-chat

APP_ENV=development

# Origens permitidas no CORS (JSON, igual ao default do Settings)
CORS_ORIGINS=["http://localhost:5174"]

# Auth da própria API (header X-API-Key). Vazio = auth desabilitada (dev).
# BLOQUEANTE definir isto antes de qualquer deploy real.
API_KEY=

# Requests/minuto por IP antes de responder 429.
RATE_LIMIT_PER_MINUTE=120

# Samples processadas em paralelo por evaluation run.
RUN_CONCURRENCY=5

# No startup, runs presas em RUNNING só são marcadas como FAILED se mais
# antigas que isto (segundos) — protege deploy rolling de matar run ativa.
ORPHANED_RUN_MAX_AGE_SECONDS=300

# Confia em X-Forwarded-For pra identificar o IP real do cliente no rate
# limit. SÓ ative se houver de fato um proxy confiável (Traefik/nginx) na
# frente que sempre sobrescreve esse header — senão um cliente direto
# forja o header e furra o rate limit.
TRUST_PROXY_HEADERS=false

# Corpo de request além disso é rejeitado com 413 (proteção de memória).
MAX_REQUEST_BODY_BYTES=25000000

# Se API_KEY estiver definida acima, o frontend precisa do mesmo valor aqui
# para anexar o header X-API-Key nas chamadas (ver frontend/src/api.ts).
VITE_API_KEY=

# URL do backend em produção (ex: https://eval-framework-backend-xxxx.run.app).
# Vazio = caminho relativo, usado em dev (proxy do vite) e no docker-compose.
# Necessário quando frontend e backend estão em domínios diferentes (ver
# .github/workflows/cd.yml — Cloudflare Pages x Cloud Run).
VITE_API_BASE_URL=
