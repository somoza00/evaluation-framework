# Copie para .env e ajuste (NUNCA commitar .env)
DATABASE_URL=postgresql+asyncpg://eval:eval@localhost:5432/evaluation
GATEWAY_URL=http://localhost:8000
GATEWAY_API_KEY=sk-local
JUDGE_MODEL=deepseek/deepseek-chat

# Auth da própria API (header X-API-Key). Vazio/ausente = auth desabilitada
# (dev). Com APP_ENV=production, deixar isto vazio impede o processo de
# subir (fail-closed, ver Settings em app/core/config.py).
API_KEY=

# Requests/minuto por IP antes de responder 429.
RATE_LIMIT_PER_MINUTE=120

# Samples processadas em paralelo por evaluation run.
RUN_CONCURRENCY=5

# Confia em X-Forwarded-For pra identificar o IP real do cliente no rate
# limit. SÓ ative atrás de um proxy confiável que sempre sobrescreve esse
# header — senão um cliente direto forja o header e furra o rate limit.
TRUST_PROXY_HEADERS=false

# Corpo de request além disso é rejeitado com 413 (proteção de memória).
MAX_REQUEST_BODY_BYTES=25000000
